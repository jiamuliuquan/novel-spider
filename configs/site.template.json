{
  "site_name": "example",
  "book_url_template": "https://example.com/{id}/",
  "book_name_regex": null,
  "encoding": null,
  "request": {
    "delay_seconds": 1.0,
    "timeout_seconds": 20,
    "retries": 2,
    "user_agent": "novel-spider/0.1 (+personal archival use)",
    "respect_robots": true
  },
  "selectors": {
    "book_name": ".book-title, h1, title",
    "chapter_links": ".chapter-list a",
    "chapter_title": "h1",
    "chapter_content": ".chapter-content",
    "remove": ["script", "style", ".ads", ".nav"]
  },
  "filters": {
    "include_url_regex": null,
    "exclude_url_regex": null
  },
  "content_filters": {
    "stop_before_text_regex": [],
    "drop_line_regex": []
  }
}
